<!-- Images for graphical representation of severity -->
{var $imgSeverityMime = "image/svg+xml"}
{var $imgSeverity = [
"severity-1" => "",
"severity-2" => "",
"severity-3" => "",
"severity-4" => "",
"severity-5" => "",
]}

{var $severityLevels = [
    'vulnSeverityCritical' => 5,
    'vulnSeverityHigh' => 4,
    'vulnSeverityMiddle' => 3,
    'vulnSeverityLow' => 2,
    'vulnSeverityInfo' => 1,
    'vulnSeverityIrrelevant' => 0,
]}

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>{ifset $title}{$title}{else}Report PENTEREP{/ifset}</title>
  <report-css/>
</head>

<body>

  <!-- Title page -->
  <div class="section1">
    <h1 style="padding-top:130px;">Web Application Security Test Report</h1>
    <h2>(by severity)</h2>
    <hr />
    <h2>{$report->project->name}</h2>
    <h2>{$report->target->address}</h2>
    <hr />
    <h3>{$report->info->created_at|date:'d.m.Y'}, version {$report->info->version}</h3>
    <h3>{$report->info->creator}</h3>
    <h3>{$report->owner->company}</h3>
    <div style="text-align:center">
      <img class="logo" src="data:{$imgLogoMime};base64,{$imgLogo}" alt="logo">
    </div>
  </div>
  <div class="pagebreak"></div>

  <!-- Table of Contents -->
  <section class="toc">
    <h2 class="bookmark-0">1 Table of Contents</h2>
    <ul>
      <li><a href="#sec-popis">2 Description of the Document</a></li>
      <li><a href="#sec-souhrn">3 Management Summary</a></li>
      <li class="toc-level-1"><a href="#sec-souhrn-severity">3.1 Summary of Findings by Severity</a></li>
      <li class="toc-level-1"><a href="#sec-souhrn-kategorie">3.2 Summary of Findings by Category</a></li>
      <li class="toc-level-1"><a href="#sec-souhrn-hlavni">3.3 Key Findings</a></li>
      <li class="toc-level-1"><a href="#sec-souhrn-zaver">3.4 Conclusion</a></li>
      <li><a href="#sec-popis-testu">4 Description and Progress of the Test</a></li>
      <li><a href="#sec-technologie">5 Identified Technologies</a></li>
      <li><a href="#sec-nalezy">6 Findings and Deficiencies</a></li>
      {foreach $severityLevels as $code => $level}
        {if $level > 0 && $vulnerabilities->where('severity_code', $code)->isNotEmpty()}
          <li class="toc-level-1"><a href="#sev-{$iterator->counter}">{$vulnerabilities->where('severity_code', $code)->first()?->severity ?? $code}</a></li>
        {/if}
      {/foreach}
    </ul>
  </section>
  <div class="pagebreak"></div>

  <!-- Description of the Document -->
  <div class="section3">
    <h2 id="sec-popis" class="bookmark-0">2 Description of the Document</h2>
    <p>This document contains the results of a penetration test commissioned by <b>{$report->owner->company}</b>. The purpose of the penetration test was to verify the security functionality of the web application <b>{$report->target->name}</b> hosted at the URL <b>{$report->target->address}</b> in practice. The penetration test was conducted at an anonymous level, without knowledge of the application's source code. The consultant from <b>{$report->owner->company}</b> performing the test had only limited knowledge of the customer's environment and primarily relied on information readily available to any Internet user. The testing aimed to uncover the potential for intrusion into the application (and other related elements, such as databases on the internal network) by a 'random' attacker (known as an 'outsider'), who has no understanding of the structure and content of the application and merely 'tries their luck'.</p>
    <p>The document is divided into several parts:
    <ul>
      <li><b>Management Summary</b> - Concise Overview of Test Progress Alongside Results</li>
      <li><b>Test Description</b> - Description of the Test Methodology</li>
      <li><b>Found Facts</b> - Deficiencies and other significant information identified during the test execution</li>
    </ul>
    </p>
    <p>This report describes the findings made during the tests and the recommendations resulting from them.</p>
  </div>
  <div class="pagebreak"></div>

  <!-- Management Summary -->
  <div class="section4">
    <h2 id="sec-souhrn" class="bookmark-0">3 Management Summary</h2>

    <h3 id="sec-souhrn-severity" class="bookmark-1">3.1 Summary of Findings by Severity</h3>
    <table>
      {foreach $severityLevels as $code => $level}
        {if $level > 0}
          {var $found = $vulnerabilities->where('severity_code', $code)}
          <tr>
            <td style="padding-right:50px;">{$found->first()?->severity ?? $code}</td>
            <td style="padding-right:50px;">{$found->count()}</td>
            <td class="graph severity-{$level}">{for $i = 0; $i < $found->count(); $i++}█{/for}</td>
          </tr>
        {/if}
      {/foreach}
    </table>

    <h3 id="sec-souhrn-kategorie" class="bookmark-1">3.2 Summary of Findings by Category</h3>
    <table>
      {foreach $categoriesDefinitions->where('category', 'L_VULNERABILITY_CATEGORY_MAIN_ASVS')->whereNull('parent_guid')->sortBy('name') as $category}
        <tr>
          <td style="padding-right:50px;">{$category->name}</td>
          <td style="padding-right:50px;">{$vulnerabilities->getByCategory($category->code)->count()}</td>
          <td class="graph bg-graph">{for $i = 0; $i < $vulnerabilities->getByCategory($category->code)->count(); $i++}█{/for}</td>
        </tr>
      {/foreach}
    </table>
  </div>
  <div class="pagebreak"></div>

  <div class="section4">
    <h3 id="sec-souhrn-hlavni" class="bookmark-1">3.3 Key Findings</h3>
    <p data-format="markdown">{$report->testing->main_findings}</p>

    <h3 id="sec-souhrn-zaver" class="bookmark-1">3.4 Conclusion</h3>
    <p data-format="markdown">{$report->testing->conclusion}</p>
    <div n:if="$report->project->score_value" style="text-align:center">
      <img class="img-severity" src="data:{$imgSeverityMime};base64,{$imgSeverity['severity-'.$report->project->score_value]}" alt="">
    </div>
  </div>
  <div class="pagebreak"></div>

  <!-- Description and Progress of the Test -->
  <div class="section5">
    <h2 id="sec-popis-testu" class="bookmark-0">4 Description and Progress of the Test</h2>

    <h3 class="bookmark-1">4.1 Subject of the Test</h3>
    <p n:if="!$report->testing->subject_description">
      The subject of the test was the web application <b>{$report->target->name}</b> operated on the domain <b>{$report->target->address}</b>.
    </p>
    <p data-format="markdown" n:if="$report->testing->subject_description">{$report->testing->subject_description}</p>

    <h3 class="bookmark-1">4.2 Testing Conditions and Limitations</h3>
    <p data-format="markdown">{$report->testing->conditions}</p>

    <h3 class="bookmark-1">4.3 The Testing Methodology</h3>
    <p>The tests were conducted through manual testing according to the following methodologies and standards:</p>
    <ul>
      {foreach $report->modules as $modul}
        <li>{$modul->name}</li>
      {/foreach}
    </ul>

    <h3 class="bookmark-1">4.4 Contacts</h3>
    {foreach $report->project->contacts->where('type', 'contactTypeSupplier') as $contact}
      <p>
        Name: {$contact->name}<br>
        Role: {$contact->role}<br>
        E-mail: {$contact->email}<br>
        Phone: {$contact->phone}
      </p>
    {/foreach}
  </div>
  <div class="pagebreak"></div>

  <!-- Identified Technologies -->
  <div class="section6">
    <h2 id="sec-technologie" class="bookmark-0">5 Identified Technologies</h2>
    <p>The following software components were identified during testing:</p>
    <table>
      <thead>
        <tr>
          <th style="padding-right:12px;">Software</th>
          <th style="padding-right:12px;">Version</th>
          <th style="text-align:center">Known Vulnerabilities</th>
        </tr>
      </thead>
      <tbody>
        {foreach $nodes->where('type', 'software')->sortBy('name') as $software}
          {var $list = $vulnerabilities->where('node_guid', $software->guid)}
          <tr>
            <td>{$software->name}</td>
            <td>{$software->properties->get('version')}</td>
            <td style="text-align:center">{foreach $list as $v}{if $v->text->code === 'PTV-WEB-SW-KNOWNVULN'}<span style="color:#c62828;font-weight:bold;">✖</span>{/if}{/foreach}</td>
          </tr>
        {/foreach}
      </tbody>
    </table>
  </div>
  <div class="pagebreak"></div>

  <!-- Findings details -->
  <div class="section6">
    <h2 id="sec-nalezy" class="bookmark-0">6 Findings and Deficiencies</h2>

    {var $categoryNo = 1}
    {foreach $severityLevels as $code => $level}
      {if $level > 0}
        {var $found = $vulnerabilities->where('severity_code', $code)}
        {if $found->isNotEmpty()}
          <h3 id="sev-{$iterator->counter}" class="bookmark-1">6.{$categoryNo} {$found->first()?->severity ?? $code} severity</h3>
          {var $findingNo = 1}
          {var $outerIterator = $iterator}

          {foreach $found as $vulnerability}
            <h4 class="bookmark-2">6.{$categoryNo}.{$findingNo} {$vulnerability->text->name}</h4>

            <h5>Severity</h5>
            <table class="detail-vuln-severity">
              <tr>
                <td rowspan="2" style="padding-right:10px;">
                  <img class="img-severity" src="data:{$imgSeverityMime};base64,{$imgSeverity['severity-'.$level]}" alt="">
                </td>
                <td>Subjectively:</td>
                <td style="padding-right:10px; font-weight:bold;">{$vulnerability->severity}</td>
                <td>CVSS score:</td>
                <td style="font-weight:bold;">{$vulnerability->cvss_score}</td>
              </tr>
              <tr>
                <td>CWE:</td>
                <td style="font-weight:bold;">{$vulnerability->text->cwe}</td>
                <td>CVSS string:</td>
                <td style="font-weight:bold;">{$vulnerability->cvss_vector}</td>
              </tr>
            </table>

            <h5>Categorization</h5>
            <p>
              {foreach $vulnerability->categories as $category}
                {$category->name}<br>
              {/foreach}
            </p>

            <h5>Vulnerability Description</h5>
            <p data-format="markdown">{$vulnerability->text->description}</p>

            <h5>Causes</h5>
            <p data-format="markdown">{$vulnerability->text->causes}</p>

            <h5>Symptoms</h5>
            <p data-format="markdown">{$vulnerability->text->displays}</p>

            <h5>Impacts</h5>
            <p data-format="markdown">{$vulnerability->text->impacts}</p>

            <h5>Remediation / Recommendations</h5>
            <p data-format="markdown">{$vulnerability->text->recommendations}</p>

            <h5>Location</h5>
            <p class="left">{$vulnerability->location}</p>

            <div n:if="$vulnerability->references->isNotEmpty()">
              <h5>References</h5>
              <ul n:inner-foreach="$vulnerability->references as $reference">
                <li>{$reference->name}<br><a href="{$reference->url}">{$reference->url}</a></li>
              </ul>
            </div>

            {var $files = $attachments->where('node_guid', $vulnerability->node_guid)}
            <div n:if="$files->isNotEmpty()">
              <h5>Attachments</h5>
              <figure n:foreach="$files as $attachment" style="margin:0 0 1rem;">
                <img n:if="$attachment->content"
                     src="data:{$attachment->mime_type};base64,{$attachment->content}"
                     alt="{$attachment->name}"
                     style="display:block; max-width:100%; height:auto;">
                <figcaption style="margin-top:.5rem;">{$attachment->name} ({$attachment->filename})</figcaption>
              </figure>
            </div>

            {var $findingNo = $findingNo + 1}
            <div class="pagebreak" n:if="!$iterator->last || !$outerIterator->last"></div>
          {/foreach}

          {var $categoryNo = $categoryNo + 1}
        {/if}
      {/if}
    {/foreach}
  </div>
</body>

</html>
