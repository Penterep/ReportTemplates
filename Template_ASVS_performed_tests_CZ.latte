<!-- Obrázky pro grafické zobrazení závažnosti -->
{var $imgSeverityMime = "image/svg+xml"}
{var $imgSeverity = [
"severity-1" => "",
"severity-2" => "",
"severity-3" => "",
"severity-4" => "",
"severity-5" => "",
]}

{var $severityLevels = [
    'vulnSeverityCritical' => 5,
    'vulnSeverityHigh' => 4,
    'vulnSeverityMiddle' => 3,
    'vulnSeverityLow' => 2,
    'vulnSeverityInfo' => 1,
    'vulnSeverityIrrelevant' => 0,
]}

<!DOCTYPE html>
<html lang="cs">

<head>
  <meta charset="utf-8" />
  <title>{ifset $title}{$title}{else}Report PENTEREP{/ifset}</title>
  <report-css/>
</head>

<body>

  <!-- Titulní stránka -->
  <div class="section1">
    <h1 style="padding-top:130px;">Přehled realizovaných bezpečnostních testů webové aplikace</h1>
    <hr />
    <h2>{$report->project->name}</h2>
    <h2>{$report->target->address}</h2>
    <hr />
    <h3>{$report->info->created_at|date:'d.m.Y'}, verze {$report->info->version}</h3>
    <h3>{$report->info->creator}</h3>
    <h3>{$report->owner->company}</h3>
    <div style="text-align:center">
      <img class="logo" src="data:{$imgLogoMime};base64,{$imgLogo}" alt="logo">
    </div>
  </div>
  <div class="pagebreak"></div>

  <!-- Obsah -->
  <section class="toc">
    <h2 class="bookmark-0">1 Obsah dokumentu</h2>
    <ul>
      <li><a href="#sec-popis">2 Popis dokumentu</a></li>
      <li><a href="#sec-souhrn">3 Manažerské shrnutí</a></li>
      <li class="toc-level-1"><a href="#sec-souhrn-severity">3.1 Přehled nálezů podle závažnosti</a></li>
      <li class="toc-level-1"><a href="#sec-souhrn-kategorie">3.2 Přehled nálezů podle kategorie</a></li>
      <li><a href="#sec-testy">4 Seznam realizovaných testů</a></li>
      {foreach $nodes as $node}
        {if $tests->where('node_guid', $node->guid)->where('status', 'Otestováno')->isNotEmpty()}
          <li class="toc-level-1"><a href="#node-{$iterator->counter}">4.{$iterator->counter} {$node->name}</a></li>
        {/if}
      {/foreach}
    </ul>
  </section>
  <div class="pagebreak"></div>

  <!-- Popis dokumentu-->
  <div class="section3">
    <h2 id="sec-popis" class="bookmark-0">2 Popis dokumentu</h2>
    <p>Tento dokument obsahuje seznam testů realizovaných během penetračního testu, jehož provedením byla pověřena společnost <b>{$report->owner->company}</b>. Penetrační test měl v praxi ověřit funkčnost zabezpečení webové aplikace <b>{$report->target->name}</b> provozované na adrese <b>{$report->target->address}</b>.</p>
    <p>Dokument je rozdělen do několika částí:
        <ul>
            <li><b>Manažerský souhrn</b> - stručný průřez průběhu testů společně s výsledky.</li>
            <li><b>Seznam realizovaných testů</b> - seznam testů realizovaných nad jednotlivými součástmi aplikace.</li>
        </ul>
    </p>
  </div>
  <div class="pagebreak"></div>

  <!-- Manažerské shrnutí -->
  <div class="section4">
    <h2 id="sec-souhrn" class="bookmark-0">3 Manažerské shrnutí</h2>

    <h3 id="sec-souhrn-severity" class="bookmark-1">3.1 Přehled nálezů podle závažnosti</h3>
    <table>
      {foreach $severityLevels as $code => $level}
        {var $found = $vulnerabilities->where('severity_code', $code)}
        <tr>
          <td style="padding-right:50px;">{$found->first()?->severity ?? $code}</td>
          <td style="padding-right:50px;">{$found->count()}</td>
          <td class="graph severity-{$level}">{for $i = 0; $i < $found->count(); $i++}█{/for}</td>
        </tr>
      {/foreach}
    </table>

    <h3 id="sec-souhrn-kategorie" class="bookmark-1">3.2 Přehled nálezů podle kategorie</h3>
    <table>
      {foreach $categoriesDefinitions->where('category', 'L_VULNERABILITY_CATEGORY_MAIN_ASVS')->whereNull('parent_guid')->sortBy('name') as $category}
        <tr>
          <td style="padding-right:50px;">{$category->name}</td>
          <td style="padding-right:50px;">{$vulnerabilities->getByCategory($category->code)->count()}</td>
          <td class="graph bg-graph">{for $i = 0; $i < $vulnerabilities->getByCategory($category->code)->count(); $i++}█{/for}</td>
        </tr>
      {/foreach}
    </table>
  </div>
  <div class="pagebreak"></div>

  <!-- Seznam realizovaných testů -->
  <div class="section6">
    <h2 id="sec-testy" class="bookmark-0">4 Seznam realizovaných testů</h2>
    {var $categoryNo = 1}
    {foreach $nodes as $node}
      {if $tests->where('node_guid', $node->guid)->where('status', 'Otestováno')->isNotEmpty()}
        <h3 id="node-{$iterator->counter}" class="bookmark-1">4.{$categoryNo} {$node->name}</h3>
        {var $outerIterator = $iterator}
        <table>
          {foreach $tests->where('node_guid', $node->guid)->where('status', 'Otestováno') as $test}
            <tr>
              <td>
                <img style="width:18px; padding-right:20px;" src="data:image/svg+xml;base64," n:if="$vulnerabilities->where('test_guid', $test->guid)->isNotEmpty()">
                <img style="width:18px; padding-right:20px;" src="data:image/svg+xml;base64," n:else>
              </td>
              <td>
                <b>{$test->text->name}</b><br>
                <i>Čas realizace: {$test->updated_at|date:'d.m.Y H:i'} &nbsp;&nbsp;&nbsp; Realizoval: {$workers->where('user_guid', $test->user_guid)->first()?->name}</i>
              </td>
            </tr>
          {/foreach}
        </table>
        {var $categoryNo = $categoryNo + 1}
      {/if}
    {/foreach}
  </div>
</body>

</html>
