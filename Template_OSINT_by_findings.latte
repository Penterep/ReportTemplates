<!-- Obrázky pro grafické zobrazení závažnosti -->
{var $imgSeverityMime = "image/svg+xml"}
{var $imgSeverity = [
"severity-1" => "",
"severity-2" => "",
"severity-3" => "",
"severity-4" => "",
"severity-5" => "",
]}

<!DOCTYPE html>
<html lang="cs">

<head>
  <meta charset="utf-8" />
  <title>{ifset $title}{$title}{else}Report PENTEREP{/ifset}</title>
  <report-css/>
</head>

<body>

  <!-- Titulní stránka -->
  <div class="section1">
    <h1 style="padding-top:130px;">Závěrečná zpráva</h1>
    <hr />
    <h2>{$report->project->name}</h2>
    <hr />
    <h3>{$report->info->created_at|date:'d.m.Y'}, verze {$report->info->version}</h3>
    <h3>{$report->info->creator}</h3>
    <h3>{$report->owner->company}</h3>
    <div style="text-align:center">
      <img class="logo" src="data:{$imgLogoMime};base64,{$imgLogo}" alt="logo">
    </div>
  </div>
  <div class="pagebreak"></div>

  <!-- Obsah -->
  <section class="toc">
    <h2 class="bookmark-0">1 Obsah dokumentu</h2>
    <ul>
      <li><a href="#sec-info">2 Základní informace</a></li>
      <li class="toc-level-1"><a href="#sec-info-popis">2.1 Popis</a></li>
      <li class="toc-level-1"><a href="#sec-info-zadani">2.2 Zadání</a></li>
      <li class="toc-level-1"><a href="#sec-info-podminky">2.3 Podmínky</a></li>
      <li class="toc-level-1"><a href="#sec-info-omezeni">2.4 Omezení</a></li>
      <li class="toc-level-1"><a href="#sec-info-vstup">2.5 Zadavatelem poskytnuté informace</a></li>
      <li><a href="#sec-shrnuti">3 Shrnutí vyšetřování</a></li>
      <li class="toc-level-1"><a href="#sec-shrnuti-hlavni">3.1 Přehled hlavních zjištění</a></li>
      <li class="toc-level-1"><a href="#sec-shrnuti-pripad">3.2 Shrnutí případu</a></li>
      <li class="toc-level-1"><a href="#sec-shrnuti-zaver">3.3 Závěr</a></li>
      <li><a href="#sec-nalezy">4 Nálezy a zjištění</a></li>
      {foreach $nodes->where('type', 'evidence') as $evidence}
        <li class="toc-level-1"><a href="#ev-{$iterator->counter}">4.{$iterator->counter} {$evidence->name}</a></li>
      {/foreach}
    </ul>
  </section>
  <div class="pagebreak"></div>

  <!-- Základní informace -->
  <div class="section3">
    <h2 id="sec-info" class="bookmark-0">2 Základní informace</h2>
    <h3 id="sec-info-popis" class="bookmark-1">2.1 Popis</h3>
    <p>{$report->project->description}</p>
    <h3 id="sec-info-zadani" class="bookmark-1">2.2 Zadání</h3>
    <p>{$report->project->task}</p>
    <h3 id="sec-info-podminky" class="bookmark-1">2.3 Podmínky</h3>
    <p>{$report->project->conditions}</p>
    <h3 id="sec-info-omezeni" class="bookmark-1">2.4 Omezení</h3>
    <p>{$report->project->limitations}</p>
    <h3 id="sec-info-vstup" class="bookmark-1">2.5 Zadavatelem poskytnuté informace</h3>
    <p>{$report->project->entry_information}</p>
  </div>
  <div class="pagebreak"></div>

  <!-- Shrnutí -->
  <div class="section4">
    <h2 id="sec-shrnuti" class="bookmark-0">3 Shrnutí vyšetřování</h2>

    <h3 id="sec-shrnuti-hlavni" class="bookmark-1">3.1 Přehled hlavních zjištění</h3>
    <ul>
      {foreach $nodes->where('type', 'evidence') as $evidence}
        <li>{$evidence->name}</li>
      {/foreach}
    </ul>

    <h3 id="sec-shrnuti-pripad" class="bookmark-1">3.2 Shrnutí případu</h3>
    <p data-format="markdown">{$report->testing->main_findings}</p>

    <h3 id="sec-shrnuti-zaver" class="bookmark-1">3.3 Závěr</h3>
    <p data-format="markdown">{$report->testing->conclusion}</p>
  </div>
  <div class="pagebreak"></div>

  <!-- Detaily nálezů -->
  <div class="section5">
    <h2 id="sec-nalezy" class="bookmark-0">4 Nálezy a zjištění</h2>
    {var $evidenceNo = 1}
    {foreach $nodes->where('type', 'evidence') as $evidence}
      <h3 id="ev-{$iterator->counter}" class="bookmark-1">4.{$evidenceNo} {$evidence->name}</h3>
      <p data-format="markdown">{$evidence->properties->get('description')}</p>
      <div n:inner-foreach="$attachments->where('node_guid', $evidence->guid) as $attachment">
        <p>{$attachment->name} ({$attachment->filename})</p>
        <img n:if="$attachment->content" src="data:{$attachment->mime_type};base64,{$attachment->content}" alt="{$attachment->name}">
      </div>

      <h4 class="bookmark-2">4.{$evidenceNo}.1 Ověření nálezu</h4>
      {var $verificationNo = 1}
      {foreach $nodes->where('type', 'verification')->where('parent_guid', $evidence->guid) as $verification}
        <h5>4.{$evidenceNo}.1.{$verificationNo} {$verification->name}</h5>
        <p data-format="markdown">{$verification->properties->get('description')}</p>
        <div n:inner-foreach="$attachments->where('node_guid', $verification->guid) as $attachment">
          <figure style="margin:0 0 1rem;">
            <img n:if="$attachment->content" src="data:{$attachment->mime_type};base64,{$attachment->content}" alt="{$attachment->name}">
            <figcaption style="margin-top:.5rem;">{$attachment->name} ({$attachment->filename})</figcaption>
          </figure>
        </div>
        {var $verificationNo = $verificationNo + 1}
      {/foreach}
      {var $evidenceNo = $evidenceNo + 1}
      <div class="pagebreak" n:if="!$iterator->last"></div>
    {/foreach}
  </div>
</body>

</html>
